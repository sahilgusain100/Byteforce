# Server Port
PORT=8000

# MongoDB Connection String (Replace with your database connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Byteforce

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# JSON Web Token (JWT) Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Environment Mode (development / production)
NODE_ENV=development

